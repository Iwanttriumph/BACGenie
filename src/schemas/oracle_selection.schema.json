{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cve_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "selected",
        "ambiguous",
        "incomplete"
      ]
    },
    "selected_template": {
      "enum": [
        "O1",
        "O2",
        "O3",
        null
      ]
    },
    "core_effect": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/Candidate"
      }
    },
    "selection_basis": {
      "type": "string",
      "minLength": 1
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "selection_prompt_sha256": {
      "type": "string",
      "minLength": 1
    },
    "selection_schema_sha256": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "cve_id",
    "status",
    "selected_template",
    "core_effect",
    "candidates",
    "selection_basis",
    "gaps"
  ],
  "additionalProperties": false,
  "$defs": {
    "Candidate": {
      "type": "object",
      "properties": {
        "template": {
          "enum": [
            "O1",
            "O2",
            "O3"
          ]
        },
        "applicable": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rejected_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "template",
        "applicable",
        "evidence",
        "gaps",
        "rejected_reason"
      ],
      "additionalProperties": false
    }
  }
}
