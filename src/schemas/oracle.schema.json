{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cve_id": {
      "type": "string",
      "minLength": 1
    },
    "oracles": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/Oracle"
      }
    }
  },
  "required": [
    "cve_id",
    "oracles"
  ],
  "additionalProperties": false,
  "$defs": {
    "Header": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "Body": {
      "type": "object",
      "properties": {
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "object"
        }
      },
      "required": [
        "format",
        "fields"
      ],
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "status_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Header"
              }
            }
          ]
        },
        "body": {}
      },
      "required": [
        "status_code",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "handler": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "type": "object",
          "required": [
            "path",
            "query"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": [
                "object",
                "null"
              ]
            },
            "query": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "headers": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Header"
              }
            }
          ]
        },
        "body": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Body"
            }
          ]
        },
        "response": {
          "$ref": "#/$defs/Response"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "method",
        "handler",
        "endpoint",
        "params",
        "headers",
        "body",
        "response",
        "actor"
      ],
      "additionalProperties": false
    },
    "Observation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "enum": [
            "before_attack",
            "before_acquisition",
            "after_acquisition",
            "during_attack",
            "after_attack",
            "after_use"
          ]
        },
        "access_check": {
          "type": "string",
          "minLength": 1
        },
        "api": {
          "anyOf": [
            {
              "$ref": "#/$defs/Request"
            },
            {
              "type": "null"
            }
          ]
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "extract": {
          "type": [
            "object",
            "null"
          ]
        },
        "assertion": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "id",
        "timing",
        "access_check",
        "api",
        "query",
        "extract",
        "assertion",
        "actor",
        "target"
      ],
      "additionalProperties": false
    },
    "Verifier": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "READ",
            "CREATE",
            "UPDATE",
            "DELETE",
            "PRIVILEGE_USE",
            "STATE_ISOLATION"
          ]
        },
        "observations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/Observation"
          }
        },
        "success_condition": {
          "type": "string",
          "minLength": 1
        },
        "unresolved_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "type",
        "observations",
        "success_condition",
        "unresolved_conditions"
      ],
      "additionalProperties": false
    },
    "AccessCheck": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "baseline",
            "acquisition",
            "use",
            "attack",
            "effect",
            "operation"
          ]
        },
        "access": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "minLength": 1
            },
            "http_method": {
              "type": [
                "string",
                "null"
              ]
            },
            "request_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "restricted_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "action",
            "http_method",
            "request_id",
            "restricted_fields"
          ],
          "additionalProperties": false
        },
        "object": {
          "type": "object",
          "properties": {
            "resource": {
              "type": "string",
              "minLength": 1
            },
            "identifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "owner": {
              "type": [
                "string",
                "null"
              ]
            },
            "scope": {
              "type": [
                "string",
                "null"
              ]
            },
            "precondition": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "resource",
            "identifier",
            "owner",
            "scope",
            "precondition"
          ],
          "additionalProperties": false
        },
        "expected_decision": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "policy_basis": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "subject",
        "phase",
        "access",
        "object",
        "expected_decision",
        "policy_basis"
      ],
      "additionalProperties": false
    },
    "PermissionCheck": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "api": {
          "anyOf": [
            {
              "$ref": "#/$defs/Request"
            },
            {
              "type": "null"
            }
          ]
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "extract": {
          "type": [
            "object",
            "null"
          ]
        },
        "assertion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "subject",
        "purpose",
        "api",
        "query",
        "extract",
        "assertion"
      ],
      "additionalProperties": false
    },
    "Control": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "api": {
          "anyOf": [
            {
              "$ref": "#/$defs/Request"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "purpose",
        "api",
        "expected",
        "constraints"
      ],
      "additionalProperties": false
    },
    "Controls": {
      "type": "object",
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Control"
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Control"
          }
        }
      },
      "required": [
        "positive",
        "negative"
      ],
      "additionalProperties": false
    },
    "ExpectedPolicy": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "rule",
        "basis"
      ],
      "additionalProperties": false
    },
    "Schedule": {
      "type": "object",
      "properties": {
        "relation": {
          "enum": [
            "before",
            "concurrent",
            "after"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "reset": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "relation",
        "condition",
        "reset",
        "attempt_limit"
      ],
      "additionalProperties": false
    },
    "CommonTemplate": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "O1",
            "O2",
            "O3"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "subjects": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "resources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "access_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/AccessCheck"
          }
        },
        "permission_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermissionCheck"
          }
        },
        "controls": {
          "$ref": "#/$defs/Controls"
        },
        "attack_request": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Request"
          }
        },
        "expected_policy": {
          "$ref": "#/$defs/ExpectedPolicy"
        }
      },
      "required": [
        "type",
        "goal",
        "subjects",
        "resources",
        "access_checks",
        "permission_checks",
        "controls",
        "attack_request",
        "expected_policy"
      ]
    },
    "O1Template": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonTemplate"
        }
      ],
      "properties": {
        "type": {
          "const": "O1"
        }
      },
      "required": [
        "type"
      ],
      "unevaluatedProperties": false
    },
    "O2Template": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonTemplate"
        }
      ],
      "properties": {
        "type": {
          "const": "O2"
        },
        "capability_change": {
          "type": "string",
          "minLength": 1
        },
        "capability_use_requests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Request"
          }
        }
      },
      "required": [
        "type",
        "capability_change",
        "capability_use_requests"
      ],
      "unevaluatedProperties": false
    },
    "O3Template": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonTemplate"
        }
      ],
      "properties": {
        "type": {
          "const": "O3"
        },
        "victim_requests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Request"
          }
        },
        "shared_state_conditions": {
          "type": "string",
          "minLength": 1
        },
        "schedule": {
          "$ref": "#/$defs/Schedule"
        }
      },
      "required": [
        "type",
        "victim_requests",
        "shared_state_conditions",
        "schedule"
      ],
      "unevaluatedProperties": false
    },
    "Oracle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "oneOf": [
            {
              "$ref": "#/$defs/O1Template"
            },
            {
              "$ref": "#/$defs/O2Template"
            },
            {
              "$ref": "#/$defs/O3Template"
            }
          ]
        },
        "verifier": {
          "$ref": "#/$defs/Verifier"
        }
      },
      "required": [
        "id",
        "template",
        "verifier"
      ],
      "additionalProperties": false
    }
  }
}
