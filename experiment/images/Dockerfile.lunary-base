# Shared toolchain base for all Kaiti Lunary images.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Use a domestically reachable Debian mirror, install native build toolchain
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g; s|http://security.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends build-essential python3 git ca-certificates; \
    rm -rf /var/lib/apt/lists/*

ENV npm_config_registry=https://registry.npmmirror.com \
    npm_config_sharp_binary_host=https://npmmirror.com/mirrors/sharp \
    npm_config_sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips \
    npm_config_audit=false \
    npm_config_fund=false \
    NODE_OPTIONS=--max-old-space-size=4096

WORKDIR /app
